PORT=3000

# Postgres do docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=barbearia
POSTGRES_PORT=5432

# Usada pela API rodando fora do Docker (yarn start:dev) e pelo Prisma CLI.
# No container da API o docker-compose troca o host para "postgres".
# Sem Docker: `yarn db:dev` (Prisma Postgres local) e cole aqui a URL "TCP" que ele mostrar.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barbearia?schema=public

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Chave de 32 bytes em base64 para cifrar o segredo do 2FA no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_ENCRYPTION_KEY=
# Nome que aparece no app autenticador.
TWO_FACTOR_ISSUER=Barbearia

# Firebase: o JSON da service account fica em credentials/firebase-service-account.json
# (Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada).
# Só defina esta variável se quiser usar outro caminho.
# FIREBASE_SERVICE_ACCOUNT_PATH=credentials/firebase-service-account.json

# ID do cliente OAuth do tipo WEB (o mesmo EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID do app).
GOOGLE_WEB_CLIENT_ID=
